{
  "name": "ReactNativeStarterKit",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "ENVFILE=.env.development react-native run-android",
    "android:prod": "ENVFILE=.env.production react-native run-android --mode release",
    "ios": "ENVFILE=.env.development react-native run-ios",
    "ios:prod": "ENVFILE=.env.production react-native run-ios --mode Release",
    "start": "react-native start",
    "start:reset": "react-native start --reset-cache",
    "env:setup": "cp -n .env.example .env.development; cp -n .env.example .env.production; echo \"Edit .env.development and .env.production\"",
    "build:aab": "cd android && ENVFILE=.env.production ./gradlew bundleRelease && echo \"AAB: android/app/build/outputs/bundle/release/app-release.aab\"",
    "build:apk": "cd android && ENVFILE=.env.production ./gradlew assembleRelease && echo \"APK: android/app/build/outputs/apk/release/app-release.apk\"",
    "pods": "cd ios && bundle install && bundle exec pod install",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "jest --forceExit",
    "clean:android": "cd android && ./gradlew clean",
    "link:fonts": "npx react-native-asset"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-navigation/bottom-tabs": "^7.21.0",
    "@react-navigation/drawer": "^7.14.4",
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/native-stack": "^7.21.0",
    "@reduxjs/toolkit": "^2.14.0",
    "axios": "^1.21.1",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-config": "^1.7.2",
    "react-native-gesture-handler": "^3.5.0",
    "react-native-permissions": "^5.6.3",
    "react-native-reanimated": "^4.7.1",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-screens": "^4.30.1",
    "react-native-worklets": "^0.13.1",
    "react-redux": "^9.3.1",
    "redux-persist": "^6.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.88.1",
    "@react-native/eslint-config": "0.88.1",
    "@react-native/jest-preset": "0.88.1",
    "@react-native/metro-config": "0.88.1",
    "@react-native/typescript-config": "0.88.1",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.3.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}

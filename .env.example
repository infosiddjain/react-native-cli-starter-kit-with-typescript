# Template for environment files. Copy it with `npm run env:setup`, which creates:
#   .env.development  -> used by `npm run android` / `npm run ios`
#   .env.production   -> used by release builds and `npm run build:aab`
# Real .env files are git-ignored. Never put secrets (private API keys,
# passwords) here: everything in these files ends up inside the app.

APP_ENV=development
API_BASE_URL=https://dummyjson.com
API_TIMEOUT=15000
ENABLE_API_LOGS=true
